# Anthropic API Key (nie echte Werte hier eintragen, nur in .env)
# Ohne Key läuft das System automatisch im Demo-/Fixture-Modus (siehe README).
ANTHROPIC_API_KEY=

# Modell für Triage- und Report-Agent
ANTHROPIC_MODEL=claude-sonnet-5-5

# API
API_PORT=8000

# MLflow: standardmäßig leer lassen - dann nutzt MLflow seinen lokalen
# File-Store (Ordner mlruns/), kein eigener Server nötig. Nur setzen, wenn
# tatsächlich ein "mlflow server" läuft (nicht "mlflow ui", das reicht nicht).
MLFLOW_TRACKING_URI=
