# Anthropic API Key (nie echte Werte hier eintragen, nur in .env)
# Ohne Key läuft das System automatisch im Demo-/Fixture-Modus (siehe README).
ANTHROPIC_API_KEY=

# Modell für Triage- und Report-Agent
ANTHROPIC_MODEL=claude-sonnet-5-5

# API
API_PORT=8000

# Erlaubter Bereich für repo_path in POST /scans. Die API lehnt jeden Pfad
# außerhalb mit HTTP 400 ab. Ohne Angabe gilt der Ordner "test_repos" im
# Arbeitsverzeichnis. Im Container setzt docker-compose.yml fest
# /app/test_repos, dieser Wert gilt dort nicht.
# VULNSCOUT_SCAN_ROOT=test_repos

# MLflow-Tracking-Server und Model Registry.
#
# Der Stack bringt einen eigenen MLflow-Dienst mit (docker compose), der unter
# http://localhost:5000 veröffentlicht wird. Dieser Wert gilt für Aufrufe vom
# Host aus, etwa beim Training des Pre-Filter-Modells:
#     python -m scripts.train_prefilter
#
# Der API-Container benutzt diesen Wert NICHT - er bekommt in
# docker-compose.yml fest http://mlflow:5000 gesetzt, weil "localhost"
# innerhalb eines Containers auf den Container selbst zeigt.
MLFLOW_TRACKING_URI=http://localhost:5000
